{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@platform/ui": ["./packages/ui/src/index.ts"],
      "@platform/ui/*": ["./packages/ui/src/*"],
      "@platform/api": ["./packages/api/src/index.ts"],
      "@platform/api/*": ["./packages/api/src/*"],
      "@platform/types": ["./packages/types/src/index.ts"],
      "@platform/types/*": ["./packages/types/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
